# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env.local` or `.env`
# 2. Fill in the relevant API keys and configuration values as needed
# 3. Never commit `.env` or `.env.local` with real private secrets to git
# ==============================================================================

# Site Configuration
VITE_SITE_URL=https://bhaveshrathod.dev
VITE_APP_TITLE="Bhavesh Rathod | AI Engineer & Senior Backend Architect"

# (Optional) Google Gemini API Key for Live AI Assistant Responses
# Get your API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# (Optional) EmailJS Configuration for Direct Contact Form Submissions
# Set up a free service at: https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# (Optional) Google Analytics 4 Measurement ID
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# (Optional) Feature Flags & Preferences
# Set to 'true' or 'false'
VITE_ENABLE_RETRO_SFX=false
VITE_DEFAULT_THEME=light
